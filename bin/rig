#!/usr/bin/env bash
# rig — CLI face of the Rig Omarchy plugin (yordanbuilds.rig).
# Pure forwarder: every command is one omarchy-shell IPC call; all logic
# lives in the plugin running inside omarchy-shell.
set -euo pipefail

ID="yordanbuilds.rig"

die() { echo "rig: $*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage:
  rig                       open the stack menu
  rig <stack>               build the stack (or focus it if running)
  rig up <stack> [-b]       same; -b/--background builds without focusing
  rig kill <stack>          close the stack's workspace
  rig new <name> [--from <stack>]   create a stack file and open it in your editor
  rig list [--json]         your stacks and what's running
  rig sync                  refresh Rig's entries in the Omarchy menu
  rig setup                 re-run first-load setup (binding, menu, symlink)
  rig uninstall             remove Rig and everything setup added
USAGE
}

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

wait_for() { # <test-flag> <path> <timeout-ms> — poll a file, fast first, then back off
  local op="$1" path="$2" timeout_ms="$3" waited=0 step
  local ramp=(5 5 10 10 20 20 30 50 50 100)
  while :; do
    test "$op" "$path" && return 0
    (( waited >= timeout_ms )) && return 1
    step=${ramp[0]}
    (( ${#ramp[@]} > 1 )) && ramp=("${ramp[@]:1}")
    sleep "0.$(printf '%03d' "$step")"
    (( waited += step ))
  done
}

call() { # <method> <json-arg>
  local out
  out=$(omarchy-shell shell call "$ID" "$1" "$2") || die "omarchy-shell call failed — is the shell running?"
  [[ "$out" == error:* ]] && die "${out#error: }"
  printf '%s\n' "$out"
}

# With a terminal, wait for the outcome and print it; menu-spawned runs
# (no tty) stay fire-and-forget and report through notifications.
call_wait() { # <method> <json-arg>
  if [[ ! -t 2 && -z ${RIG_CLI_WAIT:-} ]]; then
    call "$1" "$2"
    return
  fi
  local result arg status
  result=$(mktemp)
  : >"$result"
  arg="${2%\}},\"out\":\"$result\"}"
  call "$1" "$arg" >/dev/null
  wait_for -s "$result" 600000 || { rm -f "$result"; die "no response from the shell plugin"; }
  status=$(head -1 "$result")
  msg=$(tail -n +2 "$result")
  rm -f "$result"
  if [[ $status == ok ]]; then printf '\033[1;32m✓\033[0m %s\n' "$msg"; else die "$msg"; fi
}

confirm() { # <prompt> — gum when interactive, plain read otherwise
  if command -v gum >/dev/null 2>&1 && [[ -t 0 ]]; then
    gum confirm "$1"
  else
    printf '%s [y/N] ' "$1"
    local r
    read -r r || return 1
    [[ $r == y || $r == Y ]]
  fi
}

cmd="${1:-}"
case "$cmd" in
  "") exec omarchy-shell shell toggle omarchy.menu '{"menu":"trigger.rig"}' ;;
  -h|--help) usage; exit 0 ;;
  up|kill|new|list|sync|new-dialog|setup|uninstall) shift ;;
  *) cmd=up ;;   # sugar: rig <stack>
esac

case "$cmd" in
  up)
    name="" background=false
    for arg in "$@"; do
      case "$arg" in
        -b|--background) background=true ;;
        -*) die "unknown flag: $arg" ;;
        *) name="$arg" ;;
      esac
    done
    [[ -n "$name" ]] || { usage; exit 1; }
    call_wait up "{\"stack\":\"$(json_escape "$name")\",\"background\":$background}"
    ;;
  kill)
    [[ $# -ge 1 ]] || { usage; exit 1; }
    call_wait kill "{\"stack\":\"$(json_escape "$1")\"}"
    ;;
  new)
    name="" from=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --from) from="${2:?--from needs a stack name}"; shift 2 ;;
        -*) die "unknown flag: $1" ;;
        *) name="$1"; shift ;;
      esac
    done
    [[ -n "$name" ]] || { usage; exit 1; }
    if [[ -n "$from" ]]; then
      call create "{\"name\":\"$(json_escape "$name")\",\"from\":\"$(json_escape "$from")\"}"
    else
      call create "{\"name\":\"$(json_escape "$name")\"}"
    fi
    ;;
  list)
    fmt=text
    [[ ${1:-} == --json ]] && fmt=json
    out=$(mktemp)
    trap 'rm -f "$out"' EXIT
    : > "$out"
    call list "{\"out\":\"$out\",\"format\":\"$fmt\"}" >/dev/null
    wait_for -s "$out" 15000 || die "no response from the shell plugin"
    if grep -q '^{"error":' "$out"; then
      msg=$(grep -o '"error":"[^"]*"' "$out" | head -1 | cut -d'"' -f4)
      die "$msg"
    fi
    cat "$out"; echo
    ;;
  sync)
    script="$(readlink -f "${BASH_SOURCE[0]}")"
    exec "$(dirname "$script")/rig-menu-sync"
    ;;
  new-dialog)
    # Name prompt via the Omarchy menu's input mode (file round-trip).
    sel=$(mktemp); done_f=$(mktemp); rm -f "$done_f"
    trap 'rm -f "$sel" "$done_f"' EXIT
    omarchy-shell shell summon omarchy.menu \
      "{\"mode\":\"input\",\"prompt\":\"New stack\",\"selectionFile\":\"$sel\",\"doneFile\":\"$done_f\"}" >/dev/null
    wait_for -e "$done_f" 60000 || die "no response from the menu"
    name=$(cat "$sel" 2>/dev/null || true)
    [[ -n "$name" ]] || exit 0   # cancelled
    exec "$0" new "$name"
    ;;
  setup)
    script="$(readlink -f "${BASH_SOURCE[0]}")"
    "$(dirname "$script")/rig-setup" --force
    exec "$(dirname "$script")/rig-menu-sync"
    ;;
  uninstall)
    echo "This removes Rig: the plugin, the SUPER+R binding, the menu entries, and the CLI."
    confirm "Remove Rig?" || die "aborted"
    if confirm "Also delete your stack files in ~/.config/rig/stacks/?"; then stacks_reply=y; else stacks_reply=n; fi
    sed -i '/>>> rig >>>/,/<<< rig <<</d' "$HOME/.config/hypr/bindings.lua" 2>/dev/null || true
    sed -i '/>>> rig menu >>>/,/<<< rig menu <<</d; /"trigger\.rig/d' "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc" 2>/dev/null || true
    rm -f "$HOME/.local/bin/rig" "$HOME/.config/rig/.setup-done"
    [[ $stacks_reply == y || $stacks_reply == Y ]] && rm -rf "$HOME/.config/rig"
    exec omarchy plugin remove yordanbuilds.rig --yes
    ;;
esac
