#!/usr/bin/env bash
# rig-wait-ready <pane-id> <signal> — the gate behind `after`. The signal is
# a ready-file path (touched when the awaited command finishes) or an output
# pattern to match. Also releases when a process in the pane opens a new TCP
# listener or when its output settles. Gives up after two minutes and lets
# the dependent start anyway.
set -u

PANE="${1:?pane id}"
SIGNAL="${2:?ready file or pattern}"
TIMEOUT_MS="${RIG_WAIT_TIMEOUT_MS:-120000}"
SETTLE_MS="${RIG_WAIT_SETTLE_MS:-2000}"
MIN_MS="${RIG_WAIT_MIN_MS:-3000}"
GRACE_MS="${RIG_WAIT_GRACE_MS:-5000}"
POLL_MS=400

descendants() {
  local queue=("$1") out=() p c
  while ((${#queue[@]})); do
    p="${queue[0]}"; queue=("${queue[@]:1}")
    out+=("$p")
    for c in $(cat /proc/"$p"/task/*/children 2>/dev/null); do queue+=("$c"); done
  done
  printf '%s\n' "${out[@]}"
}

pane_listeners() { # inodes of LISTEN sockets held by the pane's process tree
  local listen fd link inode out="" pid
  listen=" $(awk '$4 == "0A" { print $10 }' /proc/net/tcp /proc/net/tcp6 2>/dev/null | sort -u | tr '\n' ' ') "
  for pid in $(descendants "$1"); do
    for fd in /proc/"$pid"/fd/*; do
      link=$(readlink "$fd" 2>/dev/null) || continue
      [[ $link == socket:* ]] || continue
      inode="${link#socket:[}"; inode="${inode%]}"
      [[ $listen == *" $inode "* ]] && out+="$inode "
    done
  done
  printf '%s' "$out"
}

read_pane() {
  herdr pane read "$PANE" --source detection --lines 40 2>/dev/null || true
}

shell_pid=$(herdr pane process-info --pane "$PANE" 2>/dev/null |
  grep -o '"shell_pid":[0-9]*' | grep -o '[0-9]*$' || true)
baseline=""
[[ -n $shell_pid ]] && baseline=" $(pane_listeners "$shell_pid") "

command_running() {
  # True when something other than the pane's shell holds the foreground.
  [[ -z $shell_pid ]] && return 0
  local fg
  fg=$(herdr pane process-info --pane "$PANE" 2>/dev/null |
    grep -o '"pid":[0-9]*' | head -1 | grep -o '[0-9]*$' || true)
  [[ -z $fg || $fg != "$shell_pid" ]]
}

elapsed=0 stable=0 last="" warned=0
while (( elapsed < TIMEOUT_MS )); do
  snap=$(read_pane)
  if [[ $SIGNAL == /* ]]; then
    [[ -e $SIGNAL ]] && { rm -f "$SIGNAL"; exit 0; }
  else
    grep -qF -- "$SIGNAL" <<<"${snap//$'\n'/}" && exit 0
  fi
  if [[ -n $shell_pid ]]; then
    for inode in $(pane_listeners "$shell_pid"); do
      [[ $baseline == *" $inode "* ]] || exit 0
    done
  fi
  if command_running; then
    if [[ -n $snap && $snap == "$last" ]]; then
      stable=$(( stable + POLL_MS ))
      (( elapsed >= MIN_MS && stable >= SETTLE_MS )) && exit 0
    else
      stable=0
    fi
  else
    stable=0
    if (( ! warned && elapsed >= GRACE_MS )); then
      echo "rig: $PANE ended without becoming ready — holding; re-run it to release, or wait for the timeout"
      warned=1
    fi
  fi
  last="$snap"
  sleep 0.4
  elapsed=$(( elapsed + POLL_MS ))
done
echo "rig: gave up waiting for $PANE — starting anyway"
exit 0
