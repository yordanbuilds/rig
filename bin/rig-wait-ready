#!/usr/bin/env bash
# rig-wait-ready <pane-id> <signal> — the gate behind `after`. The signal is
# a ready-file path (touched when the awaited command finishes) or an output
# pattern to match. Also releases when a process in the pane opens a new TCP
# listener. Gives up after two minutes and lets the dependent start anyway.
set -u

PANE="${1:?pane id}"
SIGNAL="${2:?ready file or pattern}"
TIMEOUT_MS="${RIG_WAIT_TIMEOUT_MS:-120000}"
GRACE_MS="${RIG_WAIT_GRACE_MS:-5000}"

# Ticks are 100 ms. The ready-file check is a bash builtin and effectively
# free, so it runs every tick. Pane reads, the hold warning, and the listener
# scan each cost process spawns, so they run every SLOW_EVERY-th tick.
SLOW_EVERY=4

descendants() {
  local queue=("$1") out=() p c
  while ((${#queue[@]})); do
    p="${queue[0]}"; queue=("${queue[@]:1}")
    out+=("$p")
    for c in $(cat /proc/"$p"/task/*/children 2>/dev/null); do queue+=("$c"); done
  done
  printf '%s\n' "${out[@]}"
}

global_listeners() { # inodes of every LISTEN socket on the box
  awk '$4 == "0A" { print $10 }' /proc/net/tcp /proc/net/tcp6 2>/dev/null | sort -u | tr '\n' ' '
}

pane_listeners() { # <root-pid> <listen-inodes> — the subset held by the pane's process tree
  local listen="$2" link inode out="" pid
  for pid in $(descendants "$1"); do
    while IFS= read -r link; do
      [[ $link == socket:* ]] || continue
      inode="${link#socket:[}"; inode="${inode%]}"
      [[ $listen == *" $inode "* ]] && out+="$inode "
    done < <(find /proc/"$pid"/fd -type l -printf '%l\n' 2>/dev/null)
  done
  printf '%s' "$out"
}

read_pane() {
  herdr pane read "$PANE" --source detection --lines 40 2>/dev/null || true
}

shell_pid=$(herdr pane process-info --pane "$PANE" 2>/dev/null |
  grep -o '"shell_pid":[0-9]*' | grep -o '[0-9]*$' || true)
baseline="" baseline_global=""
if [[ -n $shell_pid ]]; then
  baseline_global=" $(global_listeners) "
  baseline=" $(pane_listeners "$shell_pid" "$baseline_global") "
fi

command_running() {
  # True when something other than the pane's shell holds the foreground.
  [[ -z $shell_pid ]] && return 0
  local fg
  fg=$(herdr pane process-info --pane "$PANE" 2>/dev/null |
    grep -o '"pid":[0-9]*' | head -1 | grep -o '[0-9]*$' || true)
  [[ -z $fg || $fg != "$shell_pid" ]]
}

now_ms() { local t=${EPOCHREALTIME//[!0-9]/}; NOW_MS=$(( t / 1000 )); }

now_ms; start_ms=$NOW_MS
warned=0 tick=0
while :; do
  now_ms
  elapsed=$(( NOW_MS - start_ms ))
  (( elapsed >= TIMEOUT_MS )) && break

  if [[ $SIGNAL == /* ]]; then
    # Never delete the file: every dependent of the target polls this same
    # path, and the nonce in its name keeps stale files from releasing later runs.
    [[ -e $SIGNAL ]] && exit 0
  fi

  if (( tick % SLOW_EVERY == 0 )); then
    if [[ $SIGNAL != /* ]]; then
      grep -qF -- "$SIGNAL" < <(read_pane | tr -d '\n') && exit 0
    fi
    if [[ -n $shell_pid ]]; then
      # A new pane listener is necessarily a new global listener, so the
      # per-fd walk of the pane's process tree only runs when the box-wide
      # listen set changed — one awk per scan otherwise.
      global_now=" $(global_listeners) "
      if [[ $global_now != "$baseline_global" ]]; then
        for inode in $(pane_listeners "$shell_pid" "$global_now"); do
          [[ $baseline == *" $inode "* ]] || exit 0
        done
        baseline_global=$global_now
      fi
    fi
    if (( ! warned )) && (( elapsed >= GRACE_MS )) && ! command_running; then
      echo "rig: $PANE ended without becoming ready — holding; re-run it to release, or wait for the timeout"
      warned=1
    fi
  fi

  sleep 0.1
  (( tick++ ))
done
echo "rig: gave up waiting for $PANE — starting anyway"
exit 0
