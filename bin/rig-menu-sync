#!/usr/bin/env bash
# rig-menu-sync — regenerate Rig's entries in the Omarchy menu.
# The stack list lives as real menu rows (trigger.rig.*) inside a marked
# block of ~/.config/omarchy/extensions/omarchy-menu.jsonc; the menu
# watches that file, so changes appear without a restart. Runs at plugin
# load, after `rig new`, and via `rig sync`.
set -euo pipefail

MENU="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
STACKS="$HOME/.config/rig/stacks"
BEGIN='// >>> rig menu >>>  Managed by rig-menu-sync — do not edit inside.'
END='// <<< rig menu <<<'
# The shortcut row offers the key Rig never takes by itself, and shows only
# while no bind block exists. Cheap on purpose: the menu batches every `when:`
# into one bash script, and that script's speed is how fast the menu opens.
UNBOUND="! grep -q '>>> rig >>>' ~/.config/hypr/bindings.lua"

# JSON string escaping, the same two substitutions bin/rig uses. Backslashes
# first: escaping the quotes first would then double-escape the backslash that
# step just added.
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# The bash twin of Builder.mjs's shellQuote. A stack name reaches the menu
# inside a shell command inside a JSON string, so it needs both treatments in
# that order: one shell word first, then escaped for the JSON it sits in.
shell_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Mirrors stripJsonc() in Omarchy's shell/plugins/menu/MenuModel.js: whole-line
# // comments and trailing commas come out, and what is left must decode as a
# JSON object. A file that fails this contributes no entries at all — the menu
# drops every user row and says nothing — so nothing lands until it parses.
# Keep the s!...! delimiters: with s{...} the } inside [}\]] ends the pattern
# early, perl errors, and the gate then rejects everything.
menu_parses() {
  perl -0777 -MJSON::PP -ne '
    s!^\s*//[^\n]*(\n|$)!!gm; s!,(\s*[}\]])!$1!g;
    my $d = eval { JSON::PP->new->decode($_) };
    exit(($@ || ref $d ne "HASH") ? 1 : 0);
  ' "$1" 2>/dev/null
}

# This runs detached from the QML plugin, so a notification is the only way
# anything it decides reaches the person using it.
notify() { command -v omarchy-notification-send >/dev/null 2>&1 && omarchy-notification-send "$1" "$2" || true; }

block() {
  printf '  %s\n' "$BEGIN"
  # A seam for the test that proves the gate works. Nothing sets this in normal
  # use; the escaping in this function is what keeps real output parseable.
  if [[ -n ${RIG_MENU_FORCE_BAD_BLOCK:-} ]]; then printf '  "unterminated: {\n'; fi
  printf '  "trigger.rig": { "icon": "󰞷", "label": "Rig" },\n'
  local f name id action checked
  for f in "$STACKS"/*.json; do
    [[ -e $f ]] || continue
    name="$(basename "$f" .json)"
    # A newline or tab cannot be represented inside a JSON string by
    # json_escape, and a row carrying one would fail the parse gate on every
    # sync — notifying each time, since the file we started from was fine.
    # Drop that one row; its siblings still sync.
    [[ $name != *[[:cntrl:]]* ]] || continue
    id="$(json_escape "${name//./-}")"
    action="$(json_escape "rig $(shell_quote "$name")")"
    checked="$(json_escape "herdr workspace list 2>/dev/null | grep -qF $(shell_quote "\"label\":\"$name\"")")"
    printf '  "trigger.rig.stack-%s": { "icon": "󰆍", "label": "%s", "action": "%s", "checked": "%s" },\n' \
      "$id" "$(json_escape "$name")" "$action" "$checked"
  done
  printf '  "trigger.rig.new": { "icon": "＋", "label": "New", "action": "rig new-dialog" },\n'
  printf '  "trigger.rig.bind-key": { "icon": "󰌌", "label": "Add SUPER+R shortcut", "action": "rig bind-key", "when": "%s" },\n' \
    "$UNBOUND"
  printf '  %s\n' "$END"
}

mkdir -p "$(dirname "$MENU")" "$STACKS"
[[ -e $MENU ]] || printf '{\n}\n' >"$MENU"

tmp="$(mktemp)"
blocktmp="$(mktemp)"
trap 'rm -f "$tmp" "$blocktmp"' EXIT
block >"$blocktmp"
# Strip the old managed block plus any stray trigger.rig lines from before
# the block existed, then insert the fresh block before the closing brace,
# adding a comma to the preceding entry if it lacks one.
sed '/>>> rig menu >>>/,/<<< rig menu <<</d; /"trigger\.rig/d' "$MENU" |
  awk -v blockfile="$blocktmp" '
    { lines[NR] = $0 }
    END {
      last = 0
      for (i = 1; i <= NR; i++) if (lines[i] ~ /^[[:space:]]*}[[:space:]]*$/) last = i
      if (last == 0) exit 3
      for (j = last - 1; j >= 1; j--) {
        t = lines[j]
        sub(/[[:space:]]+$/, "", t)
        if (t == "" || t ~ /^[[:space:]]*\/\//) continue
        if (t !~ /[,{[]$/) lines[j] = lines[j] ","
        break
      }
      for (i = 1; i <= NR; i++) {
        if (i == last) while ((getline line < blockfile) > 0) print line
        print lines[i]
      }
    }
  ' >"$tmp"
if menu_parses "$tmp"; then
  mv "$tmp" "$MENU"
elif menu_parses "$MENU"; then
  # We would be the ones breaking a file that was fine. Keep theirs, say so.
  notify "Rig" "Couldn't update the menu — your omarchy-menu.jsonc was left as it was"
fi
# The remaining case is a file that was already unparseable when we arrived.
# Refusing is still right, but it is not our mess to announce on every sync.
