#!/usr/bin/env bash
# rig-ask-key — the one time Rig asks about the SUPER+R shortcut.
# Two hats in one file. With no argument it decides whether the question is
# worth asking and opens a small floating terminal to ask it; exit 0 means it
# asked, nonzero means it stayed quiet and the caller should say where the
# shortcut waits. With --prompt it *is* that question, running inside the
# terminal. Only rig-setup's first run comes through here — the menu row and
# `rig bind-key` are the late path, and they bind without asking.
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
BIN="$(dirname "$SELF")"
BINDINGS="$HOME/.config/hypr/bindings.lua"
LAUNCHER="${RIG_ASK_LAUNCHER:-omarchy-launch-floating-terminal-with-presentation}"

# Free means no block of ours and nothing else holding the key — the same
# question rig-bind-key asks before it writes, asked here first so a taken key
# costs you no window at all. Anything but a plain number back (no hyprctl, no
# jq) means we don't know, and not knowing is no reason to withhold the
# question: rig-bind-key checks again before it writes anything.
key_free() {
  grep -q '>>> rig >>>' "$BINDINGS" 2>/dev/null && return 1
  local binds taken
  binds=$(hyprctl -j binds 2>/dev/null || true)
  taken=$(jq '[.[] | select(.modmask == 64 and (.key | ascii_upcase == "R"))] | length' \
    <<<"$binds" 2>/dev/null || true)
  [[ $taken =~ ^[0-9]+$ ]] || taken=0
  (( taken == 0 ))
}

if [[ ${1:-} == --prompt ]]; then
  # The window took a moment to open; the answer may already be in.
  key_free || exit 0
  answer=n
  if command -v gum >/dev/null 2>&1 && [[ -t 0 ]]; then
    gum confirm "Rig is ready. Add the SUPER+R shortcut?" && answer=y
  else
    printf 'Rig is ready. Add the SUPER+R shortcut? [y/N] '
    read -r reply || reply=""
    [[ $reply == [Yy]* ]] && answer=y
  fi
  if [[ $answer == y ]]; then
    "$BIN/rig-bind-key"
  else
    echo "You can add it any time from the Rig menu."
  fi
  exit 0
fi

key_free || exit 1
command -v "$LAUNCHER" >/dev/null 2>&1 || exit 1
# Backgrounded: the launcher need not return before the window closes, and
# setup's caller has a menu sync waiting on setup's exit.
"$LAUNCHER" "$(printf '%q --prompt' "$SELF")" >/dev/null 2>&1 &
exit 0
